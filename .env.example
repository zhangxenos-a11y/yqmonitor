# ===== 舆情监测系统 配置示例 =====
# 复制本文件为 .env 并填写，或直接通过网页「设置」页填写

# 会话签名密钥（务必改成随机长字符串）
SECRET_KEY=please-change-me-to-a-long-random-string

# DeepSeek 情感分析 API Key（留空则退化为规则词库）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 企业微信机器人 webhook key（群机器人 URL 中 ?key= 后面的部分）
WECOM_WEBHOOK_KEY=

# 企业微信「智能机器人」凭证（Bot ID + Secret，WebSocket 长连接，二选一优先用这个）
WECOM_BOT_ID=
WECOM_BOT_SECRET=

# 监控轮询间隔（分钟）
MONITOR_INTERVAL_MINUTES=30

# 扫描时间窗口起止 HH:MM（留空=全天扫描；窗口外自动跳过扫描）
SCAN_WINDOW_START=
SCAN_WINDOW_END=

# 启用的搜索源（逗号分隔）：bing,baidu,weixin,weibo,toutiao
SEARCH_SOURCES=bing,baidu,weixin,weibo,toutiao

# HTTP 请求超时（秒）
REQUEST_TIMEOUT=10

# ===== 推送配置（1.2，也可在网页「设置」页改） =====
# 推送模式：realtime=实时推送 / scheduled=定时汇总 / both=两者都要
PUSH_MODE=realtime
# 定时汇总的每日推送时间 HH:MM
PUSH_TIME=09:00
# 实时推送时间窗口起止 HH:MM（留空=不限）
PUSH_WINDOW_START=
PUSH_WINDOW_END=
# 推送内容字段（逗号分隔，可选 title/snippet/url/platform/sentiment/level）
PUSH_FIELDS=title,snippet,url,platform,sentiment,level
# 每次推送最多带多少条
PUSH_BATCH_SIZE=5
# 最低推送级别（空=全部；一般/较大/重大/特别重大）
PUSH_MIN_LEVEL=

# 首次启动自动创建的管理员账号
DEFAULT_ADMIN=admin
DEFAULT_PASSWORD=admin123
